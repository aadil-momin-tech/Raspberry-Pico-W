from machine import Pin, ADC, I2C import time import dht from i2c_lcd import I2cLcd # === Pin Setup === dht_sensor = dht.DHT22(Pin(15)) mq4_sensor = ADC(26)  # MQ-4 analog output connected to ADC0 (GP26) buzzer = Pin(14, Pin.OUT) red_led = Pin(13, Pin.OUT) green_led = Pin(12, Pin.OUT) # === I2C for LCD === i2c = I2C(0, sda=Pin(0), scl=Pin(1), freq=400000) lcd = I2cLcd(i2c, 0x27, 2, 16)  # Adjust address if needed (0x27 or 0x3F) # === Thresholds === TEMP_LIMIT = 30         # degrees Celsius HUMIDITY_LIMIT = 70     # percent METHANE_LIMIT = 500     # ADC value threshold (adjust based on MQ-4 calibration) # === Read Methane Value from MQ-4 === def read_mq4(): return mq4_sensor.read_u16() >> 4  # Convert 16-bit to 12-bit (0–4095)  while True:     try:         dht_sensor.measure()         temp = dht_sensor.temperature()         humidity = dht_sensor.humidity()         methane = read_mq4()          # === Check Spoilage Conditions ===         is_spoiled = temp > TEMP_LIMIT or humidity > HUMIDITY_LIMIT or methane > METHANE_LIMIT          # === Set Outputs Based on Spoilage ===         if is_spoiled:             red_led.value(1)             green_led.value(0)                          # Buzzer beep-beep pattern             for _ in range(3):                 buzzer.value(1)                 time.sleep(0.2)                 buzzer.value(0)                 time.sleep(0.2)              status = "SPOILED!"         else:   red_led.value(0)             green_led.value(1)             buzzer.value(0)              # Monitor gas even if not spoiled             if methane > 400:                 status = "CH4 rising!"             elif methane > 300:                 status = "CH4 mild"             else:                 status = "Food OK :)"          # === Display on LCD ===         lcd.clear()         lcd.putstr("T:{:.1f}C H:{:.0f}%".format(temp, humidity))         lcd.move_to(0, 1)         lcd.putstr("CH4:{}>{}? {}".format(methane, METHANE_LIMIT, status))          time.sleep(2)      except Exception as e:         lcd.clear()         lcd.putstr("Sensor Error")         print("Error:", e)         time.sleep(2)
